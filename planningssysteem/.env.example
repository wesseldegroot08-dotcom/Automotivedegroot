# Kopieer dit bestand naar .env (start.sh / start.bat doet dat vanzelf).
# Zet hier NOOIT echte wachtwoorden in als je dit bestand deelt.

# Geheime sleutel voor de inlog-cookie. start.sh/start.bat maakt een willekeurige.
GEHEIME_SLEUTEL=verander-mij

# Database. Standaard een SQLite-bestand. Later kan hier een PostgreSQL-adres staan.
DATABASE_URL=sqlite:///data/planning.db

# Wachtwoord voor de demo-gebruikers (planner, admin, chauffeur). ALLEEN lokaal gebruiken.
DEMO_WACHTWOORD=demo1234

# Zet op 1 als de app achter https draait (dan krijgt de cookie de 'secure'-vlag).
COOKIE_SECURE=0
